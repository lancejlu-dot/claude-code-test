# ---- Required for the live platform (without these, the site runs in read-only DEMO MODE) ----
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Supabase "publishable" key (older projects: the anon key — NEXT_PUBLIC_SUPABASE_ANON_KEY also works)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only secret key (older projects: service_role key — SUPABASE_SERVICE_ROLE_KEY also works).
# Used only by the Stripe webhook, scheduled jobs and account deletion. Never expose it to the browser.
SUPABASE_SECRET_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Scheduled jobs (Vercel Cron sends this as a Bearer token) ----
CRON_SECRET=generate-a-long-random-string

# ---- Optional: Stripe online payments ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---- Optional: transactional email via Resend ----
RESEND_API_KEY=
EMAIL_FROM="Ridgeline Collective <hello@yourdomain.ca>"
EMAIL_REPLY_TO=
